<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Calculer"
                        Command="{Binding CalculerCommand}"/>
                <Button Grid.Column="1" Text="Effacer"
                        Command="{Binding EffacerCommand}"/>
            </Grid>

            <Label Text="{Binding Erreur}" FontSize="16"
                   TextColor="Red"
                   IsVisible="{Binding ErreurVisible}"/>

            <Label Text="{Binding Resultat}" FontSize="20"
                   IsVisible="{Binding ResultatVisible}"/>
            <Label Text="{Binding Statut}" FontSize="18"
                   FontAttributes="Bold"
                   IsVisible="{Binding ResultatVisible}"/>
            <Label Text="{Binding ProchainAnniversaire}" FontSize="16"
                   IsVisible="{Binding ResultatVisible}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
